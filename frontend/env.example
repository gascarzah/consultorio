# Variables de entorno para el Consultorio Dental

# API Configuration
VITE_API_URL=http://localhost:8080/consultorio/
VITE_API_TIMEOUT=10000

# App Configuration
VITE_APP_NAME=Consultorio Dental
VITE_APP_VERSION=2.0.0

# Environment
VITE_NODE_ENV=development

# Security
VITE_JWT_SECRET=your-jwt-secret-here

# Features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
