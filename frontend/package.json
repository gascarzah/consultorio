{
  "name": "frontendjs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --config vite.config.prod.js",
    "build:analyze": "vite build --config vite.config.prod.js && open dist/stats.html",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules/.vite",
    "size": "npm run build && npx vite-bundle-analyzer dist"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.16.1",
    "dayjs": "^1.11.21",
    "formik": "^2.4.9",
    "jwt-decode": "^3.1.2",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.8",
    "react": "^18.3.1",
    "react-calendar": "^4.8.0",
    "react-datepicker": "^4.25.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "react-modal": "^3.16.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.30.4",
    "react-search-autocomplete": "^8.5.2",
    "react-speech-recognition": "^3.10.0",
    "react-switch": "^7.0.0",
    "react-toastify": "^9.1.3",
    "regenerator-runtime": "^0.14.1",
    "sweetalert2": "^11.26.25",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss": "^3.4.19",
    "terser": "^5.48.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
