# Copiar a .env para desarrollo local (npm run dev)

VITE_API_URL=http://localhost:8080/consultorio/
VITE_API_TIMEOUT=30000

# Producción con proxy nginx (mismo dominio):
# VITE_API_URL=/consultorio/

# Registro público en /registrar (debe coincidir con backend: solo dev permite POST /usuarios)
# VITE_ALLOW_PUBLIC_REGISTER=false
