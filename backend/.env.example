# Copiar a .env (no commitear). Misma BD Docker que tvendo (container gafahnet).
SPRING_PROFILES_ACTIVE=dev

# Opción A — URL estilo Prisma/tvendo (DotenvLoader rellena DB_*)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gafahnet

# Opción B — JDBC con schema propio (recomendado para no mezclar con tvendo)
DB_URL=jdbc:postgresql://localhost:5432/gafahnet?currentSchema=consultorio
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=consultorio

JPA_SHOW_SQL=true
JPA_DDL_AUTO=validate

FLYWAY_ENABLED=true
FLYWAY_VALIDATE_ON_MIGRATE=true
FLYWAY_CLEAN_DISABLED=false
FLYWAY_CLEAN_ON_VALIDATION_ERROR=false

CRON_EXPRESSION=0 * * ? * *

JWT_SECRET_KEY=MDEyMzQ1Njc4OUFCQ0RFRjAxMjM0NTY3ODlBQkNERUY=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
