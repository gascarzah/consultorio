# Copiar a .env.prod en la raíz y completar con valores reales (NO commitear .env.prod)

# --- PostgreSQL ---
POSTGRES_DB=consultorio_db
POSTGRES_USER=consultorio_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# --- Backend (Spring) ---
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://postgres:5432/consultorio_db
DB_USERNAME=consultorio_user
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO
JPA_SHOW_SQL=false
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_VALIDATE_ON_MIGRATE=true
FLYWAY_CLEAN_DISABLED=true
CRON_EXPRESSION=0 0 2 * * ?

# JWT: generar clave Base64 segura (mín. 256 bits). Ejemplo: openssl rand -base64 32
JWT_SECRET_KEY=CAMBIAR_CLAVE_BASE64_SEGURA
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Orígenes del frontend (separados por coma, sin espacios extra)
CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# --- Frontend (build Docker) ---
# Ruta relativa si usas el proxy nginx del compose prod (mismo dominio):
VITE_API_URL=/consultorio/
VITE_API_TIMEOUT=30000

# --- Proxy ---
HTTP_PORT=80
# HTTPS_PORT=443
