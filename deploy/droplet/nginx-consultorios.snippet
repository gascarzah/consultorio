    # Consultorio — frontend estático + API Spring (añadir dentro del server { } de gafah.dev)
    location /consultorio/ {
        proxy_pass http://127.0.0.1:8082/consultorio/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /consultorios/ {
        alias /home/gafah/consultorio/frontend/;
        try_files $uri $uri/ /consultorios/index.html;
    }

    location = /consultorios {
        return 301 https://$host/consultorios/;
    }
